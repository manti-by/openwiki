{
  "name": "@manti-by/openwiki",
  "version": "0.4.1-a",
  "description": "OpenCode plugin that scaffolds a per-project session wiki (commands, templates, and the wiki/ directory). Install-only — no background agent, no event hooks.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "templates",
    "commands"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "wiki",
    "knowledge-base"
  ],
  "license": "AGPL-3.0",
  "author": "OpenWiki contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manti-by/openwiki.git"
  },
  "homepage": "https://github.com/manti-by/openwiki#readme",
  "bugs": {
    "url": "https://github.com/manti-by/openwiki/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "build:types": "tsc --declaration --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepublishOnly": "npm run build && npm run build:types",
    "prepack": "npm run build && npm run build:types"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
